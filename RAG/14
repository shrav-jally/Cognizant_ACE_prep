Q14. Asynchronous Document Processing Pipeline
Topics: Module Architecture

Task: Implement `AsyncRAGPipeline` using Python `asyncio` to execute ingestion, embedding creation, and index insertion concurrently for high throughput.

Solution Architecture:

    import asyncio
    from concurrent.futures import ThreadPoolExecutor
    from pathlib import Path
    from typing import List, Dict, Any, Union

    class AsyncRAGPipeline:
        """Executes ingestion, chunking, and embedding generation asynchronously across multiple files."""

        def __init__(self, loader_cls, chunker_fn, embedder, vector_store, max_workers: int = 4):
            self.loader_cls = loader_cls
            self.chunker_fn = chunker_fn
            self.embedder = embedder
            self.vector_store = vector_store
            self.executor = ThreadPoolExecutor(max_workers=max_workers)

        def _process_single_file(self, file_path: Path) -> Dict[str, Any]:
            """Synchronous worker function to load, chunk, and embed a single document."""
            loader = self.loader_cls(file_path)
            doc_data = loader.load()

            chunks = self.chunker_fn(doc_data["content"])
            texts = [c["text"] for c in chunks]

            embeddings = self.embedder.embed_texts(texts)

            payloads = [
                {
                    "text": chunk["text"],
                    "chunk_id": chunk["chunk_id"],
                    **doc_data["metadata"]
                }
                for chunk in chunks
            ]

            return {"embeddings": embeddings, "payloads": payloads}

        async def process_file_async(self, file_path: Path) -> int:
            """Runs single-file processing on a non-blocking thread pool worker."""
            loop = asyncio.get_running_loop()
            result = await loop.run_in_executor(
                self.executor, self._process_single_file, file_path
            )
            
            self.vector_store.add_documents(result["embeddings"], result["payloads"])
            return len(result["payloads"])

        async def process_batch_async(self, file_paths: List[Union[str, Path]]) -> int:
            """Processes a collection of files concurrently using asyncio.gather."""
            tasks = [self.process_file_async(Path(fp)) for fp in file_paths]
            chunk_counts = await asyncio.gather(*tasks, return_exceptions=False)
            return sum(chunk_counts)

        def shutdown(self):
            """Cleanly releases thread pool resources."""
            self.executor.shutdown(wait=True)
