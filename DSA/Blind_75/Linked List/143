# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def reorderList(self, head: ListNode | None) -> None:
        arr=[]
        curr=head
        while curr:
            arr.append(curr)
            curr=curr.next

        l,r =0, len(arr)-1
        curr=head
        while l<r:
            arr[l].next=arr[r]
            l+=1
            if l==r:
                break
            arr[r].next=arr[l]
            r-=1
        arr[l].next=None
