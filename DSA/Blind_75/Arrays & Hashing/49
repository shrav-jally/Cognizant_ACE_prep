T: O(n × k log k) / S: O(n × k)

from collections import defaultdict
class Solution:
    def groupAnagrams(self, strs):
        d=defaultdict(list)
        for _ in strs:
            count=[0]*26
            for c in _:
                count[ord(c)-ord('a')]+=1
            d[tuple(count)].append(_)
        return list(d.values())
