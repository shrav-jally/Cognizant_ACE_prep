T: O(n) / S: O(n)

class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        sd=defaultdict(int)
        for i in s:
            sd[i]+=1
        for i in t:
            sd[i]-=1
        for i in sd.values():
            if i!=0:
                return False
        return True





T: O(n) / S: O(1)

class Solution:
    def isAnagram(self, s, t):
        if len(s) != len(t):
            return False
        count = [0] * 26

        for i in range(len(s)):
            count[ord(s[i]) - ord('a')] += 1
            count[ord(t[i]) - ord('a')] -= 1

        return all(x == 0 for x in count)
