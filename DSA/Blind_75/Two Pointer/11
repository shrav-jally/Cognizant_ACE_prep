class Solution:
    def maxArea(self, height: List[int]) -> int:
        l, r=0, len(height)-1
        mv=0
        temp=0
        while l<r:
            temp=(min(height[l],height[r]))*(r-l)
            mv=max(mv, temp)
            if height[l]>height[r]:
                r-=1
            else:
                l+=1
        return mv
